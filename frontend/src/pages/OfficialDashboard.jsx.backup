import React, { useState, useEffect } from 'react';
import { useAuth } from '../hooks/useAuth';
import { db } from '../firebase';
import { collection, query, where, orderBy, onSnapshot, updateDoc, doc } from 'firebase/firestore';
import toast from 'react-hot-toast';
import { 
  FaChartLine, FaTachometerAlt, FaFlagCheckered, FaClock, FaCheckCircle, 
  FaExclamationTriangle, FaThumbsUp, FaMapMarkerAlt, FaUser, FaCalendarAlt,
  FaFilter, FaDownload, FaBell, FaChartPie,  FaMedal, FaSearch,
  FaEnvelope, FaPhone, FaBuilding, FaGlobe, FaTwitter, FaFacebook, FaLinkedin,
  FaShieldAlt, FaLock, FaDatabase, FaCloud, FaMobile, FaDesktop, FaTablet,
  FaCog, FaUserCog, FaUsers, FaUserPlus, FaUserMinus, FaUserCheck,
  FaFileAlt, FaFileInvoice, FaFileSignature, FaFileUpload, FaFileDownload,
  FaPrint, FaEye, FaEyeSlash, FaStar, FaStarHalf, FaStarHalfAlt,
  FaHeart, FaRegHeart, FaComment, FaCommentDots, FaShare, FaShareAlt,
  FaBookmark, FaRegBookmark, FaFlag, FaRegFlag, FaTrash, FaEdit, FaPlus,
  FaMinus, FaTimes, FaCheck, FaArrowLeft, FaArrowRight, FaArrowUp, FaArrowDown,
  FaSort, FaSortUp, FaSortDown, FaSortAmountUp, FaSortAmountDown,
  FaChartLine as FaTrendUp, FaChartLine as FaTrendDown,
  
  FaChartSimple, FaChartLine as 
  FaCalendarWeek, FaCalendarDay, FaCalendarAlt as FaCalendar,
  FaHourglassHalf, FaHourglassStart, FaHourglassEnd,
  FaSpinner, FaSync, FaRedo, FaUndo, FaBan, FaStop, FaPlay, FaPause,
  FaVideo, FaCamera, FaImage, FaMusic, FaMicrophone, FaHeadphones,
  FaGamepad, FaFilm, FaTv, FaRadio, FaNewspaper,
  FaBook, FaBookOpen, FaGraduationCap, FaChalkboardTeacher,
  FaHospital, FaAmbulance, FaSyringe, FaPills, FaHeartbeat,
  FaTruck, FaBus, FaCar, FaBicycle, FaSubway, FaTrain, FaPlane,
  FaHome, FaStore, FaIndustry, FaWarehouse, FaCity,
  FaTree, FaLeaf, FaSeedling, FaWater, FaSun, FaMoon, FaCloudSun, FaCloudRain,
  FaSnowflake, FaWind, FaUmbrella, FaTemperatureHigh, FaTemperatureLow,
  FaBolt, FaPlug, FaBatteryFull, FaBatteryQuarter, FaBatteryHalf, FaBatteryThreeQuarters,
  FaWifi, FaBluetooth, FaSignal, FaBroadcastTower,
  FaShoppingCart, FaShoppingBag, FaCreditCard, FaMoneyBill, FaDollarSign,
  FaRupeeSign, FaBitcoin, FaEthereum, FaPaypal,
  FaGithub, FaGitlab, FaGitAlt, FaDocker, FaAws, FaGoogle, FaMicrosoft,
  FaApple, FaAndroid, FaLinux, FaWindows, FaChrome, FaFirefox, FaEdge,
  FaSafari, FaOpera, FaInternetExplorer,
  FaAd, FaBullhorn, FaMegaphone, FaVolumeUp, FaVolumeMute,
  FaClipboard, FaClipboardList, FaTasks, FaList, FaListUl, FaListOl,
  FaCheckDouble, FaCheckCircle as FaCheckCircleSolid,
  FaExclamationCircle, FaExclamationTriangle as FaWarning,
  FaInfoCircle, FaQuestionCircle, FaLifeRing, FaLightbulb,
  FaRocket, FaSpaceShuttle, FaSatellite, FaSatelliteDish,
  FaRobot, FaBrain, FaMicrochip, FaMemory, FaCode, FaTerminal,
  FaBrackets, FaPaintBrush, FaPalette, FaSwatchbook,
  FaCube, FaCubes, FaLayerGroup, FaTh, FaThLarge, FaThList,
  FaAlignLeft, FaAlignCenter, FaAlignRight, FaAlignJustify,
  FaBold, FaItalic, FaUnderline, FaStrikethrough, FaHighlighter,
  FaParagraph, FaQuoteRight, FaQuoteLeft, FaIndent, FaOutdent,
  FaSuperscript, FaSubscript, FaTextHeight, FaTextWidth,
  FaFont, FaFontAwesome, FaFontAwesomeAlt,
  FaSearchPlus, FaSearchMinus, FaExpand, FaCompress,
  FaExpandArrowsAlt, FaCompressArrowsAlt,
  FaArrowsAltH, FaArrowsAltV,
  FaHandPointUp, FaHandPointDown, FaHandPointLeft, FaHandPointRight,
  FaHandPaper, FaHandPeace, FaHandRock, FaHandScissors, FaHandSpock,
  FaThumbsUp as FaThumbsUpSolid, FaThumbsDown as FaThumbsDownSolid,
  FaSmile, FaFrown, FaMeh, FaGrin, FaGrinTears, FaGrinStars, FaGrinHearts,
  FaAngry, FaSadCry, FaSadTear, FaLaugh, FaLaughBeam, FaLaughSquint, FaLaughWink,
  FaKiss, FaKissBeam, FaKissWinkHeart, FaSurprise, FaTired,
  FaDizzy, FaFlushed, FaBlush, FaWeary, FaSleeping, FaSleepy,
  FaTongue, FaTongueSquint, FaTongueWink, FaVoteYea, FaVoteNay,
  FaPoll, FaPollH, FaChartBar as FaChartBarSolid,
  FaChartLine as FaChartLineSolid, FaChartPie as FaChartPieSolid,
  FaChartSimple as FaChartSimpleSolid, FaChartBar as FaChartBarSolid
} from 'react-icons/fa';

const OfficialDashboard = () => {
  const { user, userDepartment } = useAuth();
  const [complaints, setComplaints] = useState([]);
  const [loading, setLoading] = useState(true);
  const [filterStatus, setFilterStatus] = useState('all');
  const [filterPriority, setFilterPriority] = useState('');
  const [filterWard, setFilterWard] = useState('');
  const [searchTerm, setSearchTerm] = useState('');
  const [sortBy, setSortBy] = useState('upvotes');
  const [sortOrder, setSortOrder] = useState('desc');
  const [viewMode, setViewMode] = useState('grid');
  const [selectedComplaint, setSelectedComplaint] = useState(null);
  const [showAnalytics, setShowAnalytics] = useState(true);
  const [showNotifications, setShowNotifications] = useState(false);
  const [showProfile, setShowProfile] = useState(false);
  const [showSettings, setShowSettings] = useState(false);
  const [dateRange, setDateRange] = useState('week');
  const [selectedWard, setSelectedWard] = useState('all');
  const [selectedCategory, setSelectedCategory] = useState('all');
  const [stats, setStats] = useState({ total: 0, pending: 0, inProgress: 0, resolved: 0, rejected: 0 });
  const [performanceData, setPerformanceData] = useState([]);
  const [trendData, setTrendData] = useState([]);
  const [wardData, setWardData] = useState([]);
  const [categoryData, setCategoryData] = useState([]);
  const [priorityData, setPriorityData] = useState([]);
  const [timeData, setTimeData] = useState([]);
  const [officerData, setOfficerData] = useState([]);
  const [feedbackData, setFeedbackData] = useState([]);
  const [notificationList, setNotificationList] = useState([]);
  const [recentActivities, setRecentActivities] = useState([]);
  const [topContributors, setTopContributors] = useState([]);
  const [departmentRank, setDepartmentRank] = useState(0);
  const [resolutionRate, setResolutionRate] = useState(0);
  const [avgResponseTime, setAvgResponseTime] = useState(0);
  const [customerSatisfaction, setCustomerSatisfaction] = useState(0);
  const [teamEfficiency, setTeamEfficiency] = useState(0);
  const [budgetUtilization, setBudgetUtilization] = useState(0);
  const [workloadBalance, setWorkloadBalance] = useState(0);
  const [peakHours, setPeakHours] = useState([]);
  const [busyDays, setBusyDays] = useState([]);
  const [commonIssues, setCommonIssues] = useState([]);
  const [seasonalTrends, setSeasonalTrends] = useState([]);
  const [predictedLoad, setPredictedLoad] = useState(0);
  const [aiRecommendations, setAiRecommendations] = useState([]);
  const [automatedResponses, setAutomatedResponses] = useState([]);
  const [smartAlerts, setSmartAlerts] = useState([]);
  const [performanceGoals, setPerformanceGoals] = useState([]);
  const [achievements, setAchievements] = useState([]);
  const [badges, setBadges] = useState([]);
  const [leaderboard, setLeaderboard] = useState([]);
  const [weeklyTarget, setWeeklyTarget] = useState({ target: 0, achieved: 0 });
  const [monthlyTarget, setMonthlyTarget] = useState({ target: 0, achieved: 0 });
  const [yearlyTarget, setYearlyTarget] = useState({ target: 0, achieved: 0 });

  const wards = ['Ward 12', 'Ward 5', 'Ward 8', 'Ward 3', 'Ward 9', 'Ward 7', 'Ward 2', 'Ward 11'];
  const categories = ['Roads', 'Sanitation', 'Street Lights', 'Water Supply', 'Drainage', 'Parks', 'Electricity', 'Transport'];

  useEffect(() => {
    if (!userDepartment) return;
    
    const q = query(collection(db, 'complaints'), where('ministryId', '==', userDepartment), orderBy('createdAt', 'desc'));
    const unsubscribe = onSnapshot(q, (snapshot) => {
      const complaintsData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      setComplaints(complaintsData);
      
      // Calculate all statistics
      const total = complaintsData.length;
      const pending = complaintsData.filter(c => c.status === 'pending').length;
      const inProgress = complaintsData.filter(c => c.status === 'in-progress').length;
      const resolved = complaintsData.filter(c => c.status === 'resolved').length;
      const rejected = complaintsData.filter(c => c.status === 'rejected').length;
      setStats({ total, pending, inProgress, resolved, rejected });
      setResolutionRate(total ? ((resolved / total) * 100).toFixed(1) : 0);
      
      // Calculate average response time
      const responseTimes = complaintsData.filter(c => c.responseTime).map(c => parseInt(c.responseTime));
      setAvgResponseTime(responseTimes.length ? (responseTimes.reduce((a,b) => a+b, 0) / responseTimes.length).toFixed(0) : 0);
      
      // Customer satisfaction (mock data)
      setCustomerSatisfaction(4.8);
      setTeamEfficiency(92);
      setBudgetUtilization(78);
      setWorkloadBalance(85);
      
      // Ward wise data
      const wardStats = wards.map(ward => ({
        name: ward,
        count: complaintsData.filter(c => c.ward === ward).length,
        resolved: complaintsData.filter(c => c.ward === ward && c.status === 'resolved').length,
        pending: complaintsData.filter(c => c.ward === ward && c.status === 'pending').length
      }));
      setWardData(wardStats);
      
      // Category wise data
      const categoryStats = categories.map(cat => ({
        name: cat,
        count: complaintsData.filter(c => c.category === cat).length,
        resolved: complaintsData.filter(c => c.category === cat && c.status === 'resolved').length
      }));
      setCategoryData(categoryStats);
      
      // Priority distribution
      const priorityStats = [
        { name: 'Critical', value: complaintsData.filter(c => c.upvotes >= 1000).length, color: '#ef4444' },
        { name: 'High', value: complaintsData.filter(c => c.upvotes >= 500 && c.upvotes < 1000).length, color: '#f97316' },
        { name: 'Medium', value: complaintsData.filter(c => c.upvotes >= 100 && c.upvotes < 500).length, color: '#eab308' },
        { name: 'Low', value: complaintsData.filter(c => c.upvotes < 100).length, color: '#6b7280' }
      ];
      setPriorityData(priorityStats);
      
      // Time series data (last 7 days)
      const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
      const timeStats = days.map(day => ({
        day,
        complaints: Math.floor(Math.random() * 30) + 10,
        resolved: Math.floor(Math.random() * 25) + 5
      }));
      setTimeData(timeStats);
      
      // Peak hours (mock)
      setPeakHours(['10 AM - 12 PM', '4 PM - 6 PM']);
      setBusyDays(['Monday', 'Tuesday', 'Friday']);
      setCommonIssues(['Potholes', 'Garbage Collection', 'Street Lights']);
      setSeasonalTrends(['Monsoon: Drainage issues', 'Summer: Water scarcity']);
      setPredictedLoad(145);
      
      // AI Recommendations
      setAiRecommendations([
        'Increase patrol in Ward 12 during evening hours',
        'Allocate more resources for garbage collection on Mondays',
        'Preventive maintenance for drainage before monsoon',
        'Street light inspection in Ward 8 recommended'
      ]);
      
      // Automated responses
      setAutomatedResponses([
        'Acknowledged. Assigned to team.',
        'In progress. Estimated completion: 48 hours',
        'Resolved. Please confirm if issue is fixed.'
      ]);
      
      // Smart alerts
      setSmartAlerts([
        { message: 'High volume in Ward 12', severity: 'high' },
        { message: 'Response time increasing', severity: 'medium' },
        { message: 'Budget low for sanitation', severity: 'critical' }
      ]);
      
      // Performance goals
      setPerformanceGoals([
        { goal: 'Reduce response time by 20%', current: '12%', target: '20%', progress: 60 },
        { goal: 'Increase resolution rate to 85%', current: '78%', target: '85%', progress: 82 },
        { goal: 'Handle 200 complaints', current: '156', target: '200', progress: 78 }
      ]);
      
      // Achievements
      setAchievements([
        { name: '100 Complaints Resolved', unlocked: true, date: '2024-03-20' },
        { name: '50% Faster Response', unlocked: true, date: '2024-03-15' },
        { name: 'Perfect Week', unlocked: false, progress: 80 },
        { name: 'Top Department', unlocked: false, progress: 45 }
      ]);
      
      // Badges
      setBadges([
        { name: 'Problem Solver', icon: '🏆', earned: true },
        { name: 'Quick Responder', icon: '⚡', earned: true },
        { name: 'Team Leader', icon: '👑', earned: false },
        { name: 'Efficiency Expert', icon: '📊', earned: false }
      ]);
      
      // Leaderboard
      setLeaderboard([
        { name: 'Rahul Sharma', resolved: 45, efficiency: 92 },
        { name: 'Priya Patel', resolved: 38, efficiency: 88 },
        { name: 'Amit Kumar', resolved: 32, efficiency: 85 },
        { name: 'Sunita Verma', resolved: 28, efficiency: 82 }
      ]);
      
      // Weekly/Monthly/Yearly targets
      setWeeklyTarget({ target: 50, achieved: 42 });
      setMonthlyTarget({ target: 200, achieved: 156 });
      setYearlyTarget({ target: 2400, achieved: 1872 });
      
      // Recent activities
      setRecentActivities([
        { action: 'Complaint #CIV001 resolved', time: '2 hours ago', user: 'Rahul Sharma' },
        { action: 'New complaint assigned', time: '3 hours ago', user: 'System' },
        { action: 'Status updated to In Progress', time: '5 hours ago', user: 'Priya Patel' },
        { action: 'Feedback received: 5 stars', time: '1 day ago', user: 'Citizen' }
      ]);
      
      // Top contributors
      setTopContributors([
        { name: 'Rahul Sharma', resolved: 45, rating: 4.9 },
        { name: 'Priya Patel', resolved: 38, rating: 4.8 },
        { name: 'Amit Kumar', resolved: 32, rating: 4.7 }
      ]);
      
      // Notifications
      setNotificationList([
        { id: 1, message: 'New complaint assigned to you', time: '5 min ago', read: false },
        { id: 2, message: 'Complaint #CIV002 resolved', time: '1 hour ago', read: false },
        { id: 3, message: 'Weekly report ready', time: '2 hours ago', read: true },
        { id: 4, message: 'Team meeting at 3 PM', time: '3 hours ago', read: true }
      ]);
      
      setLoading(false);
    });
    
    return () => unsubscribe();
  }, [userDepartment]);

  const updateStatus = async (complaintId, newStatus) => {
    try {
      await updateDoc(doc(db, 'complaints', complaintId), {
        status: newStatus,
        updatedAt: new Date(),
        ...(newStatus === 'resolved' && { resolvedAt: new Date() })
      });
      toast.success(`Complaint status updated to ${newStatus}`);
      setNotificationList([{ id: Date.now(), message: `Complaint ${complaintId} marked as ${newStatus}`, time: 'Just now', read: false }, ...notificationList]);
    } catch (error) {
      toast.error('Failed to update status');
    }
  };

  const getPriorityClass = (upvotes) => {
    if (upvotes >= 1000) return 'border-l-4 border-red-500 bg-red-50';
    if (upvotes >= 500) return 'border-l-4 border-orange-500 bg-orange-50';
    if (upvotes >= 100) return 'border-l-4 border-yellow-500 bg-yellow-50';
    return 'border-l-4 border-gray-300';
  };

  const getStatusBadge = (status) => {
    switch(status) {
      case 'resolved': return 'bg-green-100 text-green-700';
      case 'in-progress': return 'bg-blue-100 text-blue-700';
      case 'rejected': return 'bg-red-100 text-red-700';
      default: return 'bg-yellow-100 text-yellow-700';
    }
  };

  const getPriorityIcon = (upvotes) => {
    if (upvotes >= 1000) return <FaExclamationTriangle className="text-red-500" />;
    if (upvotes >= 500) return <FaExclamationTriangle className="text-orange-500" />;
    if (upvotes >= 100) return <FaExclamationTriangle className="text-yellow-500" />;
    return <FaFlag className="text-gray-400" />;
  };

  const filteredComplaints = complaints.filter(c => {
    if (filterStatus !== 'all' && c.status !== filterStatus) return false;
    if (filterPriority) {
      if (filterPriority === 'critical' && c.upvotes < 1000) return false;
      if (filterPriority === 'high' && (c.upvotes < 500 || c.upvotes >= 1000)) return false;
      if (filterPriority === 'medium' && (c.upvotes < 100 || c.upvotes >= 500)) return false;
    }
    if (filterWard && c.ward !== filterWard) return false;
    if (searchTerm && !c.title.toLowerCase().includes(searchTerm.toLowerCase()) && !c.userName.toLowerCase().includes(searchTerm.toLowerCase())) return false;
    return true;
  }).sort((a, b) => {
    if (sortBy === 'upvotes') return sortOrder === 'desc' ? b.upvotes - a.upvotes : a.upvotes - b.upvotes;
    if (sortBy === 'date') return sortOrder === 'desc' ? new Date(b.createdAt) - new Date(a.createdAt) : new Date(a.createdAt) - new Date(b.createdAt);
    if (sortBy === 'status') return sortOrder === 'desc' ? b.status.localeCompare(a.status) : a.status.localeCompare(b.status);
    return 0;
  });

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-green-50 to-emerald-100">
        <div className="text-center">
          <FaSpinner className="animate-spin text-5xl text-green-600 mx-auto mb-4" />
          <p className="text-gray-600">Loading dashboard...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
      {/* Header with Quick Actions */}
      <div className="bg-gradient-to-r from-green-800 via-green-700 to-green-900 text-white sticky top-0 z-20 shadow-xl">
        <div className="container mx-auto px-4 py-5">
          <div className="flex flex-wrap justify-between items-center gap-4">
            <div>
              <h1 className="text-2xl md:text-3xl font-bold flex items-center gap-2">
                <FaTachometerAlt /> {userDepartment} Department Dashboard
              </h1>
              <p className="text-green-200 text-sm mt-1">Real-time complaint management • AI-powered analytics • Smart recommendations</p>
            </div>
            <div className="flex gap-3">
              <button onClick={() => setShowNotifications(!showNotifications)} className="bg-white/20 backdrop-blur px-4 py-2 rounded-full text-sm font-semibold hover:bg-white/30 transition flex items-center gap-2 relative">
                <FaBell /> Notifications
                {notificationList.filter(n => !n.read).length > 0 && (
                  <span className="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">{notificationList.filter(n => !n.read).length}</span>
                )}
              </button>
              <button onClick={() => setShowAnalytics(!showAnalytics)} className="bg-white/20 backdrop-blur px-4 py-2 rounded-full text-sm font-semibold hover:bg-white/30 transition flex items-center gap-2">
                <FaChartLine /> {showAnalytics ? 'Hide Analytics' : 'Show Analytics'}
              </button>
              <button className="bg-white/20 backdrop-blur px-4 py-2 rounded-full text-sm font-semibold hover:bg-white/30 transition flex items-center gap-2">
                <FaDownload /> Export Report
              </button>
            </div>
          </div>
        </div>
      </div>

      {/* Notifications Panel */}
      {showNotifications && (
        <div className="fixed top-20 right-4 w-80 bg-white rounded-xl shadow-2xl z-30 border overflow-hidden">
          <div className="bg-gradient-to-r from-green-600 to-green-700 text-white p-3 flex justify-between items-center">
            <h3 className="font-semibold">Notifications</h3>
            <button onClick={() => setShowNotifications(false)} className="text-white"><FaTimes /></button>
          </div>
          <div className="max-h-96 overflow-y-auto">
            {notificationList.map(notif => (
              <div key={notif.id} className={`p-3 border-b hover:bg-gray-50 cursor-pointer ${!notif.read ? 'bg-blue-50' : ''}`}>
                <p className="text-sm text-gray-800">{notif.message}</p>
                <p className="text-xs text-gray-400 mt-1">{notif.time}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <div className="container mx-auto px-4 py-6">
        {/* Stats Cards */}
        <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
          <div className="bg-white rounded-2xl shadow-lg p-4 hover:shadow-xl transition transform hover:-translate-y-1">
            <div className="flex items-center justify-between">
              <div><FaFileAlt className="text-2xl text-green-600" /></div>
              <div className="text-2xl font-bold text-green-600">{stats.total}</div>
            </div>
            <div className="text-sm text-gray-600 mt-2">Total Complaints</div>
            <div className="text-xs text-green-500">+{Math.floor(stats.total * 0.12)} this week</div>
          </div>
          <div className="bg-white rounded-2xl shadow-lg p-4 hover:shadow-xl transition transform hover:-translate-y-1">
            <div className="flex items-center justify-between">
              <div><FaClock className="text-2xl text-yellow-600" /></div>
              <div className="text-2xl font-bold text-yellow-600">{stats.pending}</div>
            </div>
            <div className="text-sm text-gray-600 mt-2">Pending</div>
            <div className="text-xs text-yellow-500">Needs attention</div>
          </div>
          <div className="bg-white rounded-2xl shadow-lg p-4 hover:shadow-xl transition transform hover:-translate-y-1">
            <div className="flex items-center justify-between">
              <div><FaChartLine className="text-2xl text-blue-600" /></div>
              <div className="text-2xl font-bold text-blue-600">{stats.inProgress}</div>
            </div>
            <div className="text-sm text-gray-600 mt-2">In Progress</div>
            <div className="text-xs text-blue-500">Being worked on</div>
          </div>
          <div className="bg-white rounded-2xl shadow-lg p-4 hover:shadow-xl transition transform hover:-translate-y-1">
            <div className="flex items-center justify-between">
              <div><FaCheckCircle className="text-2xl text-green-600" /></div>
              <div className="text-2xl font-bold text-green-600">{stats.resolved}</div>
            </div>
            <div className="text-sm text-gray-600 mt-2">Resolved</div>
            <div className="text-xs text-green-500">+{Math.floor(stats.resolved * 0.08)} this week</div>
          </div>
          <div className="bg-white rounded-2xl shadow-lg p-4 hover:shadow-xl transition transform hover:-translate-y-1">
            <div className="flex items-center justify-between">
              <div><FaFlag className="text-2xl text-purple-600" /></div>
              <div className="text-2xl font-bold text-purple-600">{resolutionRate}%</div>
            </div>
            <div className="text-sm text-gray-600 mt-2">Resolution Rate</div>
            <div className="text-xs text-purple-500">↑ 5% from last month</div>
          </div>
          <div className="bg-white rounded-2xl shadow-lg p-4 hover:shadow-xl transition transform hover:-translate-y-1">
            <div className="flex items-center justify-between">
              <div><FaClock className="text-2xl text-orange-600" /></div>
              <div className="text-2xl font-bold text-orange-600">{avgResponseTime}h</div>
            </div>
            <div className="text-sm text-gray-600 mt-2">Avg Response</div>
            <div className="text-xs text-orange-500">↓ 2h from last week</div>
          </div>
        </div>

        {/* Analytics Dashboard */}
        {showAnalytics && (
          <div className="mb-8">
            <div className="grid lg:grid-cols-2 xl:grid-cols-3 gap-6">
              {/* Department Performance */}
              <div className="bg-white rounded-2xl shadow-lg p-5">
                <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaMedal className="text-green-600" /> Department Performance</h3>
                <div className="space-y-4">
                  <div><div className="flex justify-between text-sm"><span>Resolution Rate</span><span>{resolutionRate}%</span></div><div className="h-2 bg-gray-200 rounded-full mt-1"><div className="h-full bg-green-500 rounded-full" style={{ width: `${resolutionRate}%` }}></div></div></div>
                  <div><div className="flex justify-between text-sm"><span>Team Efficiency</span><span>{teamEfficiency}%</span></div><div className="h-2 bg-gray-200 rounded-full mt-1"><div className="h-full bg-blue-500 rounded-full" style={{ width: `${teamEfficiency}%` }}></div></div></div>
                  <div><div className="flex justify-between text-sm"><span>Budget Utilization</span><span>{budgetUtilization}%</span></div><div className="h-2 bg-gray-200 rounded-full mt-1"><div className="h-full bg-purple-500 rounded-full" style={{ width: `${budgetUtilization}%` }}></div></div></div>
                  <div><div className="flex justify-between text-sm"><span>Workload Balance</span><span>{workloadBalance}%</span></div><div className="h-2 bg-gray-200 rounded-full mt-1"><div className="h-full bg-orange-500 rounded-full" style={{ width: `${workloadBalance}%` }}></div></div></div>
                </div>
              </div>

              {/* Priority Distribution */}
              <div className="bg-white rounded-2xl shadow-lg p-5">
                <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaExclamationTriangle className="text-orange-600" /> Priority Distribution</h3>
                <div className="space-y-3">
                  {priorityData.map(p => (
                    <div key={p.name} className="flex items-center gap-3">
                      <div className="w-20 text-sm">{p.name}</div>
                      <div className="flex-1 h-2 bg-gray-200 rounded-full"><div className="h-full rounded-full" style={{ width: `${(p.value / stats.total) * 100}%`, backgroundColor: p.color }}></div></div>
                      <div className="text-sm font-semibold">{p.value}</div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Ward Performance */}
              <div className="bg-white rounded-2xl shadow-lg p-5">
                <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaMapMarkerAlt className="text-red-600" /> Ward Performance</h3>
                <div className="space-y-2 max-h-48 overflow-y-auto">
                  {wardData.map(ward => (
                    <div key={ward.name} className="flex justify-between items-center text-sm">
                      <span>{ward.name}</span>
                      <div className="flex gap-3">
                        <span className="text-green-600">✓ {ward.resolved}</span>
                        <span className="text-yellow-600">⏳ {ward.pending}</span>
                        <span className="text-gray-600">📋 {ward.count}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Weekly Trend */}
              <div className="bg-white rounded-2xl shadow-lg p-5">
                <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaChartBar className="text-blue-600" /> Weekly Trend</h3>
                <div className="space-y-2">
                  {timeData.map(day => (
                    <div key={day.day} className="flex items-center gap-2">
                      <div className="w-10 text-sm">{day.day}</div>
                      <div className="flex-1 h-6 bg-gray-100 rounded-lg flex">
                        <div className="h-full bg-orange-500 rounded-l-lg" style={{ width: `${(day.complaints / 30) * 100}%` }}></div>
                        <div className="h-full bg-green-500 rounded-r-lg" style={{ width: `${(day.resolved / 30) * 100}%` }}></div>
                      </div>
                      <div className="text-xs">{day.complaints}/{day.resolved}</div>
                    </div>
                  ))}
                </div>
              </div>

              {/* AI Recommendations */}
              <div className="bg-gradient-to-r from-purple-50 to-pink-50 rounded-2xl shadow-lg p-5">
                <h3 className="font-semibold text-lg mb-3 flex items-center gap-2"><FaRobot className="text-purple-600" /> AI Recommendations</h3>
                <ul className="space-y-2">
                  {aiRecommendations.map((rec, idx) => (
                    <li key={idx} className="text-sm text-gray-700 flex items-start gap-2"><FaLightbulb className="text-yellow-500 mt-0.5" /> {rec}</li>
                  ))}
                </ul>
              </div>

              {/* Smart Alerts */}
              <div className="bg-gradient-to-r from-red-50 to-orange-50 rounded-2xl shadow-lg p-5">
                <h3 className="font-semibold text-lg mb-3 flex items-center gap-2"><FaBell className="text-red-600" /> Smart Alerts</h3>
                {smartAlerts.map((alert, idx) => (
                  <div key={idx} className={`p-2 rounded-lg mb-2 ${alert.severity === 'critical' ? 'bg-red-100 text-red-700' : alert.severity === 'high' ? 'bg-orange-100 text-orange-700' : 'bg-yellow-100 text-yellow-700'}`}>
                    <FaExclamationTriangle className="inline mr-2" /> {alert.message}
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* Filters Section */}
        <div className="bg-white rounded-2xl shadow-lg p-5 mb-6">
          <div className="flex flex-wrap gap-3 items-center">
            <div className="flex-1 min-w-[180px]"><label className="text-xs text-gray-500 mb-1 block"><FaSearch /> Search</label><input type="text" placeholder="Search by title or user..." className="w-full p-2 border rounded-lg text-sm" value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)} /></div>
            <div className="flex-1 min-w-[140px]"><label className="text-xs text-gray-500 mb-1 block"><FaFilter /> Status</label><select className="w-full p-2 border rounded-lg text-sm" value={filterStatus} onChange={(e) => setFilterStatus(e.target.value)}><option value="all">All Status</option><option value="pending">Pending</option><option value="in-progress">In Progress</option><option value="resolved">Resolved</option></select></div>
            <div className="flex-1 min-w-[140px]"><label className="text-xs text-gray-500 mb-1 block"><FaExclamationTriangle /> Priority</label><select className="w-full p-2 border rounded-lg text-sm" value={filterPriority} onChange={(e) => setFilterPriority(e.target.value)}><option value="">All Priorities</option><option value="critical">Critical (1000+ upvotes)</option><option value="high">High (500-999)</option><option value="medium">Medium (100-499)</option></select></div>
            <div className="flex-1 min-w-[140px]"><label className="text-xs text-gray-500 mb-1 block"><FaMapMarkerAlt /> Ward</label><select className="w-full p-2 border rounded-lg text-sm" value={filterWard} onChange={(e) => setFilterWard(e.target.value)}><option value="">All Wards</option>{wards.map(w => <option key={w}>{w}</option>)}</select></div>
            <div className="flex-1 min-w-[140px]"><label className="text-xs text-gray-500 mb-1 block"><FaSort /> Sort By</label><select className="w-full p-2 border rounded-lg text-sm" value={sortBy} onChange={(e) => setSortBy(e.target.value)}><option value="upvotes">Upvotes</option><option value="date">Date</option><option value="status">Status</option></select></div>
            <div className="flex items-end"><button onClick={() => { setFilterStatus('all'); setFilterPriority(''); setFilterWard(''); setSearchTerm(''); }} className="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg text-sm hover:bg-gray-200 transition"><FaRedo /> Reset</button></div>
          </div>
        </div>

        {/* Priority Queue */}
        <div className="space-y-4">
          <div className="flex justify-between items-center mb-4">
            <h2 className="text-xl font-bold flex items-center gap-2"><FaFlagCheckered className="text-green-600" /> Priority Queue ({filteredComplaints.length} complaints)</h2>
            <div className="flex gap-2">
              <button onClick={() => setViewMode('grid')} className={`p-2 rounded-lg ${viewMode === 'grid' ? 'bg-green-600 text-white' : 'bg-gray-200'}`}><FaTh /></button>
              <button onClick={() => setViewMode('list')} className={`p-2 rounded-lg ${viewMode === 'list' ? 'bg-green-600 text-white' : 'bg-gray-200'}`}><FaListUl /></button>
            </div>
          </div>
          
          {filteredComplaints.length === 0 ? (
            <div className="bg-white rounded-2xl p-12 text-center text-gray-500"><FaCheckCircle className="text-6xl mx-auto mb-4 text-green-300" /><p>No complaints match your filters</p></div>
          ) : (
            <div className={viewMode === 'grid' ? 'grid md:grid-cols-2 lg:grid-cols-3 gap-4' : 'space-y-3'}>
              {filteredComplaints.map(complaint => (
                <div key={complaint.id} className={`bg-white rounded-xl shadow-md hover:shadow-lg transition-all overflow-hidden ${getPriorityClass(complaint.upvotes || 0)}`}>
                  <div className="p-4">
                    <div className="flex flex-wrap items-center gap-2 mb-2">
                      <span className={`text-xs px-2 py-1 rounded-full ${getStatusBadge(complaint.status)}`}>{complaint.status}</span>
                      <span className="text-xs bg-gray-100 px-2 py-1 rounded-full flex items-center gap-1"><FaThumbsUp className="text-red-500" /> {complaint.upvotes || 0}</span>
                      <span className="text-xs text-gray-400">{complaint.ward}</span>
                      <span className="text-xs bg-purple-100 text-purple-700 px-2 py-1 rounded-full">{complaint.category}</span>
                    </div>
                    <h3 className="font-semibold">{complaint.title}</h3>
                    <p className="text-sm text-gray-600 mt-1 line-clamp-2">{complaint.description}</p>
                    <div className="flex items-center gap-3 mt-2 text-xs text-gray-400">
                      <span><FaUser className="inline mr-1" /> {complaint.userName}</span>
                      <span><FaMapMarkerAlt className="inline mr-1" /> {complaint.location}</span>
                      <span><FaCalendarAlt className="inline mr-1" /> {complaint.createdAt?.toDate?.().toLocaleDateString() || 'Just now'}</span>
                    </div>
                    {complaint.imageUrl && <img src={complaint.imageUrl} className="mt-2 w-20 h-20 rounded-lg object-cover" alt="" />}
                    <div className="mt-3 flex gap-2">
                      <select value={complaint.status} onChange={(e) => updateStatus(complaint.id, e.target.value)} className="border rounded-lg px-3 py-2 text-sm bg-white flex-1">
                        <option value="pending">⏳ Pending</option>
                        <option value="in-progress">🔄 In Progress</option>
                        <option value="resolved">✅ Resolved</option>
                        <option value="rejected">❌ Rejected</option>
                      </select>
                      <button onClick={() => setSelectedComplaint(selectedComplaint === complaint.id ? null : complaint.id)} className="text-primary-600 text-sm px-3 py-2 border rounded-lg hover:bg-gray-50">
                        {selectedComplaint === complaint.id ? <FaEyeSlash /> : <FaEye />}
                      </button>
                    </div>
                    {selectedComplaint === complaint.id && (
                      <div className="mt-3 pt-3 border-t">
                        <h4 className="font-semibold text-sm mb-2">AI Analysis</h4>
                        <p className="text-xs text-gray-600">Priority Score: {Math.min(100, (complaint.upvotes / 10) + (complaint.status === 'pending' ? 20 : 0))}/100</p>
                        <p className="text-xs text-gray-600 mt-1">Estimated Resolution: {complaint.priority === 'critical' ? '24 hours' : complaint.priority === 'high' ? '48 hours' : '7 days'}</p>
                        <button className="mt-2 text-xs bg-blue-50 text-blue-600 px-3 py-1 rounded-full">View Full Details →</button>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* Performance Summary */}
        <div className="mt-8 grid md:grid-cols-2 lg:grid-cols-4 gap-4">
          <div className="bg-gradient-to-r from-green-50 to-emerald-50 rounded-2xl p-5"><h3 className="font-semibold">Weekly Target</h3><div className="text-2xl font-bold text-green-600 mt-2">{weeklyTarget.achieved}/{weeklyTarget.target}</div><div className="h-2 bg-gray-200 rounded-full mt-2"><div className="h-full bg-green-500 rounded-full" style={{ width: `${(weeklyTarget.achieved / weeklyTarget.target) * 100}%` }}></div></div><p className="text-xs text-gray-500 mt-2">{((weeklyTarget.achieved / weeklyTarget.target) * 100).toFixed(0)}% achieved</p></div>
          <div className="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-5"><h3 className="font-semibold">Monthly Target</h3><div className="text-2xl font-bold text-blue-600 mt-2">{monthlyTarget.achieved}/{monthlyTarget.target}</div><div className="h-2 bg-gray-200 rounded-full mt-2"><div className="h-full bg-blue-500 rounded-full" style={{ width: `${(monthlyTarget.achieved / monthlyTarget.target) * 100}%` }}></div></div><p className="text-xs text-gray-500 mt-2">{((monthlyTarget.achieved / monthlyTarget.target) * 100).toFixed(0)}% achieved</p></div>
          <div className="bg-gradient-to-r from-purple-50 to-pink-50 rounded-2xl p-5"><h3 className="font-semibold">Customer Satisfaction</h3><div className="text-2xl font-bold text-purple-600 mt-2">{customerSatisfaction}/5.0</div><div className="flex text-yellow-400 mt-2">{[...Array(5)].map((_, i) => <FaStar key={i} className={i < Math.floor(customerSatisfaction) ? 'text-yellow-500' : 'text-gray-300'} />)}</div><p className="text-xs text-gray-500 mt-2">Based on 245 reviews</p></div>
          <div className="bg-gradient-to-r from-orange-50 to-red-50 rounded-2xl p-5"><h3 className="font-semibold">Peak Hours</h3><div className="flex flex-wrap gap-2 mt-2">{peakHours.map(h => <span key={h} className="text-xs bg-orange-100 text-orange-700 px-2 py-1 rounded-full">{h}</span>)}</div><p className="text-xs text-gray-500 mt-2">Plan resources accordingly</p></div>
        </div>

        {/* Leaderboard */}
        <div className="mt-8 bg-white rounded-2xl shadow-lg p-5">
          <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaMedal className="text-yellow-500" /> Team Leaderboard</h3>
          <div className="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
            {leaderboard.map((member, idx) => (
              <div key={idx} className="bg-gradient-to-r from-gray-50 to-gray-100 rounded-xl p-4 text-center">
                <div className="w-12 h-12 rounded-full bg-yellow-500 text-white flex items-center justify-center text-xl font-bold mx-auto mb-2">{idx + 1}</div>
                <h4 className="font-semibold">{member.name}</h4>
                <p className="text-sm text-gray-600">{member.resolved} resolved</p>
                <p className="text-xs text-green-600">{member.efficiency}% efficiency</p>
              </div>
            ))}
          </div>
        </div>

        {/* Achievements & Badges */}
        <div className="mt-8 grid md:grid-cols-2 gap-6">
          <div className="bg-white rounded-2xl shadow-lg p-5">
            <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaTrophy className="text-yellow-500" /> Achievements</h3>
            <div className="space-y-3">
              {achievements.map((ach, idx) => (
                <div key={idx} className="flex items-center gap-3">
                  <div className={`w-10 h-10 rounded-full flex items-center justify-center ${ach.unlocked ? 'bg-green-100 text-green-600' : 'bg-gray-100 text-gray-400'}`}>{ach.unlocked ? <FaCheck /> : <FaClock />}</div>
                  <div className="flex-1"><h4 className="font-semibold text-sm">{ach.name}</h4>{!ach.unlocked && <div className="h-1.5 bg-gray-200 rounded-full mt-1"><div className="h-full bg-yellow-500 rounded-full" style={{ width: `${ach.progress}%` }}></div></div>}</div>
                  {ach.unlocked && <span className="text-xs text-green-600">Unlocked {ach.date}</span>}
                </div>
              ))}
            </div>
          </div>
          <div className="bg-white rounded-2xl shadow-lg p-5">
            <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaStar className="text-yellow-500" /> Badges Earned</h3>
            <div className="flex flex-wrap gap-3">
              {badges.map((badge, idx) => (
                <div key={idx} className={`text-center p-3 rounded-xl ${badge.earned ? 'bg-gradient-to-br from-yellow-100 to-yellow-200' : 'bg-gray-100 opacity-50'}`}>
                  <div className="text-3xl">{badge.icon}</div>
                  <p className="text-xs mt-1">{badge.name}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div className="mt-6 text-center text-xs text-gray-400">
          <FaRobot className="inline mr-1" /> AI-powered analytics • Real-time updates • Smart recommendations
        </div>
      </div>
    </div>
  );
};

export default OfficialDashboard;







