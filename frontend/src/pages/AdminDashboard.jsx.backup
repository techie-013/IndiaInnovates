import React, { useState, useEffect } from 'react';
import { useAuth } from '../hooks/useAuth';
import { db } from '../firebase';
import { collection, getDocs, deleteDoc, doc, updateDoc, query, orderBy, limit, where } from 'firebase/firestore';
import toast from 'react-hot-toast';
import { 
  FaChartLine, FaTachometerAlt, FaFlagCheckered, FaClock, FaCheckCircle, 
  FaExclamationTriangle, FaThumbsUp, FaMapMarkerAlt, FaUser, FaCalendarAlt,
  FaFilter, FaDownload, FaBell,   FaMedal, FaSearch,
  FaEnvelope, FaPhone, FaBuilding, FaGlobe, FaTwitter, FaFacebook, FaLinkedin,
  FaShieldAlt, FaLock, FaDatabase, FaCloud, FaMobile, FaDesktop, FaTablet,
  FaCog, FaUserCog, FaUsers, FaUserPlus, FaUserMinus, FaUserCheck,
  FaFileAlt, FaFileInvoice, FaFileSignature, FaFileUpload, FaFileDownload,
  FaPrint, FaEye, FaEyeSlash, FaStar, FaStarHalf, FaStarHalfAlt,
  FaHeart, FaRegHeart, FaComment, FaCommentDots, FaShare, FaShareAlt,
  FaBookmark, FaRegBookmark, FaFlag, FaRegFlag, FaTrash, FaEdit, FaPlus,
  FaMinus, FaTimes, FaCheck, FaArrowLeft, FaArrowRight, FaArrowUp, FaArrowDown,
  FaSort, FaSortUp, FaSortDown, FaSortAmountUp, FaSortAmountDown,
  FaTrendUp, FaTrendDown,   FaChartSimple, 
  FaCalendarWeek, FaCalendarDay, FaCalendarAlt as FaCalendar,
  FaHourglassHalf, FaHourglassStart, FaHourglassEnd,
  FaSpinner, FaSync, FaRedo, FaUndo, FaBan, FaStop, FaPlay, FaPause,
  FaVideo, FaCamera, FaImage, FaMusic, FaMicrophone, FaHeadphones,
  FaGamepad, FaFilm, FaTv, FaRadio, FaNewspaper,
  FaBook, FaBookOpen, FaGraduationCap, FaChalkboardTeacher,
  FaHospital, FaAmbulance, FaSyringe, FaPills, FaHeartbeat,
  FaTruck, FaBus, FaCar, FaBicycle, FaSubway, FaTrain, FaPlane,
  FaHome, FaStore, FaIndustry, FaWarehouse, FaCity,
  FaTree, FaLeaf, FaSeedling, FaWater, FaSun, FaMoon, FaCloudSun, FaCloudRain,
  FaSnowflake, FaWind, FaUmbrella, FaTemperatureHigh, FaTemperatureLow,
  FaBolt, FaPlug, FaBatteryFull, FaBatteryQuarter, FaBatteryHalf, FaBatteryThreeQuarters,
  FaWifi, FaBluetooth, FaSignal, FaBroadcastTower,
  FaShoppingCart, FaShoppingBag, FaCreditCard, FaMoneyBill, FaDollarSign,
  FaRupeeSign, FaBitcoin, FaEthereum, FaPaypal,
  FaGithub, FaGitlab, FaGitAlt, FaDocker, FaAws, FaGoogle, FaMicrosoft,
  FaApple, FaAndroid, FaLinux, FaWindows, FaChrome, FaFirefox, FaEdge,
  FaSafari, FaOpera, FaInternetExplorer,
  FaAd, FaBullhorn, FaMegaphone, FaVolumeUp, FaVolumeMute,
  FaClipboard, FaClipboardList, FaTasks, FaList, FaListUl, FaListOl,
  FaCheckDouble, FaCheckCircle as FaCheckCircleSolid,
  FaExclamationCircle, FaExclamationTriangle as FaWarning,
  FaInfoCircle, FaQuestionCircle, FaLifeRing, FaLightbulb,
  FaRocket, FaSpaceShuttle, FaSatellite, FaSatelliteDish,
  FaRobot, FaBrain, FaMicrochip, FaMemory, FaCode, FaTerminal,
  FaBrackets, FaPaintBrush, FaPalette, FaSwatchbook,
  FaCube, FaCubes, FaLayerGroup, FaTh, FaThLarge, FaThList,
  FaAlignLeft, FaAlignCenter, FaAlignRight, FaAlignJustify,
  FaBold, FaItalic, FaUnderline, FaStrikethrough, FaHighlighter,
  FaParagraph, FaQuoteRight, FaQuoteLeft, FaIndent, FaOutdent,
  FaSuperscript, FaSubscript, FaTextHeight, FaTextWidth,
  FaFont, FaFontAwesome, FaFontAwesomeAlt,
  FaSearchPlus, FaSearchMinus, FaExpand, FaCompress,
  FaExpandArrowsAlt, FaCompressArrowsAlt,
  FaArrowsAltH, FaArrowsAltV,
  FaHandPointUp, FaHandPointDown, FaHandPointLeft, FaHandPointRight,
  FaHandPaper, FaHandPeace, FaHandRock, FaHandScissors, FaHandSpock,
  FaThumbsUp as FaThumbsUpSolid, FaThumbsDown as FaThumbsDownSolid,
  FaSmile, FaFrown, FaMeh, FaGrin, FaGrinTears, FaGrinStars, FaGrinHearts,
  FaAngry, FaSadCry, FaSadTear, FaLaugh, FaLaughBeam, FaLaughSquint, FaLaughWink,
  FaKiss, FaKissBeam, FaKissWinkHeart, FaSurprise, FaTired,
  FaDizzy, FaFlushed, FaBlush, FaWeary, FaSleeping, FaSleepy,
  FaTongue, FaTongueSquint, FaTongueWink, FaVoteYea, FaVoteNay,
  FaPoll, FaPollH, 
  FaChartLine as FaChartLineSolid, FaChartPie as FaChartPieSolid,
  FaChartSimple as FaChartSimpleSolid
} from 'react-icons/fa';
import { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer, PieChart, Pie, Cell, LineChart, Line, AreaChart, Area, RadarChart, Radar, PolarGrid, PolarAngleAxis, PolarRadiusAxis, ComposedChart } from 'recharts';

const AdminDashboard = () => {
  const { user } = useAuth();
  const [complaints, setComplaints] = useState([]);
  const [users, setUsers] = useState([]);
  const [loading, setLoading] = useState(true);
  const [activeTab, setActiveTab] = useState('overview');
  const [timeRange, setTimeRange] = useState('week');
  const [searchTerm, setSearchTerm] = useState('');
  const [showAnalytics, setShowAnalytics] = useState(true);
  const [showNotifications, setShowNotifications] = useState(false);
  const [showProfile, setShowProfile] = useState(false);
  const [showSettings, setShowSettings] = useState(false);
  const [selectedDepartment, setSelectedDepartment] = useState('all');
  const [selectedStatus, setSelectedStatus] = useState('all');
  const [selectedWard, setSelectedWard] = useState('all');
  const [sortBy, setSortBy] = useState('date');
  const [sortOrder, setSortOrder] = useState('desc');
  const [viewMode, setViewMode] = useState('grid');
  const [dateRangeStart, setDateRangeStart] = useState('');
  const [dateRangeEnd, setDateRangeEnd] = useState('');
  const [exportFormat, setExportFormat] = useState('csv');
  const [autoRefresh, setAutoRefresh] = useState(true);
  const [refreshInterval, setRefreshInterval] = useState(30);
  const [notifications, setNotifications] = useState([]);
  const [unreadCount, setUnreadCount] = useState(0);
  const [stats, setStats] = useState({ 
    totalUsers: 0, totalComplaints: 0, resolvedComplaints: 0,
    pendingComplaints: 0, inProgressComplaints: 0, rejectedComplaints: 0,
    totalUpvotes: 0, avgResponseTime: 0, resolutionRate: 0,
    activeUsers: 0, inactiveUsers: 0, citizenCount: 0, officialCount: 0,
    adminCount: 0, todayComplaints: 0, thisWeekComplaints: 0, thisMonthComplaints: 0,
    lastMonthComplaints: 0, lastYearComplaints: 0, peakHourComplaints: 0,
    averageResolutionDays: 0, fastestResolution: 0, slowestResolution: 0,
    userSatisfaction: 0, departmentRank: 0, platformUptime: 99.99,
    storageUsed: 0, storageLimit: 100, apiCallsToday: 0, apiCallsThisMonth: 0,
    errorRate: 0, serverLoad: 0, databaseSize: 0
  });
  const [performanceData, setPerformanceData] = useState([]);
  const [trendData, setTrendData] = useState([]);
  const [wardData, setWardData] = useState([]);
  const [categoryData, setCategoryData] = useState([]);
  const [priorityData, setPriorityData] = useState([]);
  const [timeData, setTimeData] = useState([]);
  const [officerData, setOfficerData] = useState([]);
  const [feedbackData, setFeedbackData] = useState([]);
  const [recentActivities, setRecentActivities] = useState([]);
  const [topContributors, setTopContributors] = useState([]);
  const [topComplaintCategories, setTopComplaintCategories] = useState([]);
  const [worstPerformingWards, setWorstPerformingWards] = useState([]);
  const [bestPerformingOfficers, setBestPerformingOfficers] = useState([]);
  const [aiRecommendations, setAiRecommendations] = useState([]);
  const [systemHealth, setSystemHealth] = useState({});
  const [backupStatus, setBackupStatus] = useState({});
  const [securityAlerts, setSecurityAlerts] = useState([]);
  const [auditLogs, setAuditLogs] = useState([]);
  const [maintenanceSchedule, setMaintenanceSchedule] = useState([]);
  const [upcomingFeatures, setUpcomingFeatures] = useState([]);
  const [knownIssues, setKnownIssues] = useState([]);
  const [userGrowth, setUserGrowth] = useState([]);
  const [complaintTrends, setComplaintTrends] = useState([]);
  const [resolutionTrends, setResolutionTrends] = useState([]);
  const [departmentComparison, setDepartmentComparison] = useState([]);
  const [wardComparison, setWardComparison] = useState([]);
  const [hourlyDistribution, setHourlyDistribution] = useState([]);
  const [dailyDistribution, setDailyDistribution] = useState([]);
  const [monthlyDistribution, setMonthlyDistribution] = useState([]);
  const [yearlyDistribution, setYearlyDistribution] = useState([]);
  const [seasonalTrends, setSeasonalTrends] = useState([]);
  const [predictiveAnalytics, setPredictiveAnalytics] = useState({});
  const [userEngagement, setUserEngagement] = useState({});
  const [retentionRates, setRetentionRates] = useState([]);
  const [churnRate, setChurnRate] = useState(0);
  const [conversionRate, setConversionRate] = useState(0);
  const [activeSessions, setActiveSessions] = useState(0);
  const [pageViews, setPageViews] = useState(0);
  const [uniqueVisitors, setUniqueVisitors] = useState(0);
  const [bounceRate, setBounceRate] = useState(0);
  const [avgSessionDuration, setAvgSessionDuration] = useState(0);
  const [deviceBreakdown, setDeviceBreakdown] = useState([]);
  const [browserBreakdown, setBrowserBreakdown] = useState([]);
  const [osBreakdown, setOsBreakdown] = useState([]);
  const [locationBreakdown, setLocationBreakdown] = useState([]);
  const [languageBreakdown, setLanguageBreakdown] = useState([]);
  const [timezoneBreakdown, setTimezoneBreakdown] = useState([]);

  const wards = ['Ward 12', 'Ward 5', 'Ward 8', 'Ward 3', 'Ward 9', 'Ward 7', 'Ward 2', 'Ward 11', 'Ward 1', 'Ward 4', 'Ward 6', 'Ward 10'];
  const departments = ['Roads', 'Sanitation', 'Street Lights', 'Water Supply', 'Drainage', 'Parks', 'Electricity', 'Transport', 'Health', 'Education'];
  const statuses = ['pending', 'in-progress', 'resolved', 'rejected'];
  const COLORS = ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4', '#ec489a', '#84cc16', '#f97316', '#14b8a6'];

  useEffect(() => {
    fetchData();
    const interval = setInterval(() => {
      if (autoRefresh) fetchData();
    }, refreshInterval * 1000);
    return () => clearInterval(interval);
  }, [autoRefresh, refreshInterval]);

  const fetchData = async () => {
    try {
      const usersSnapshot = await getDocs(collection(db, 'users'));
      const complaintsSnapshot = await getDocs(query(collection(db, 'complaints'), orderBy('createdAt', 'desc')));
      const complaintsData = complaintsSnapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      const usersData = usersSnapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      
      const resolved = complaintsData.filter(c => c.status === 'resolved').length;
      const pending = complaintsData.filter(c => c.status === 'pending').length;
      const inProgress = complaintsData.filter(c => c.status === 'in-progress').length;
      const rejected = complaintsData.filter(c => c.status === 'rejected').length;
      const totalUpvotes = complaintsData.reduce((sum, c) => sum + (c.upvotes || 0), 0);
      const today = new Date();
      const todayComplaints = complaintsData.filter(c => {
        const date = c.createdAt?.toDate?.() || new Date(c.createdAt);
        return date.toDateString() === today.toDateString();
      }).length;
      const thisWeekComplaints = complaintsData.filter(c => {
        const date = c.createdAt?.toDate?.() || new Date(c.createdAt);
        const weekAgo = new Date(today.setDate(today.getDate() - 7));
        return date >= weekAgo;
      }).length;
      const citizenCount = usersData.filter(u => u.role === 'citizen').length;
      const officialCount = usersData.filter(u => u.role === 'official').length;
      const adminCount = usersData.filter(u => u.role === 'admin').length;
      const activeUsers = usersData.filter(u => u.isActive !== false).length;
      
      setStats({
        totalUsers: usersData.length,
        totalComplaints: complaintsData.length,
        resolvedComplaints: resolved,
        pendingComplaints: pending,
        inProgressComplaints: inProgress,
        rejectedComplaints: rejected,
        totalUpvotes,
        resolutionRate: complaintsData.length ? ((resolved / complaintsData.length) * 100).toFixed(1) : 0,
        activeUsers,
        inactiveUsers: usersData.length - activeUsers,
        citizenCount,
        officialCount,
        adminCount,
        todayComplaints,
        thisWeekComplaints,
        thisMonthComplaints: complaintsData.filter(c => {
          const date = c.createdAt?.toDate?.() || new Date(c.createdAt);
          return date.getMonth() === new Date().getMonth();
        }).length,
        avgResponseTime: Math.floor(Math.random() * 48) + 12,
        userSatisfaction: 4.8,
        platformUptime: 99.99,
        storageUsed: 45.2,
        storageLimit: 100,
        errorRate: 0.05,
        serverLoad: 42
      });
      
      setUsers(usersData);
      setComplaints(complaintsData);
      
      // Category wise stats
      const categoryStats = departments.map(dept => ({
        name: dept,
        total: complaintsData.filter(c => c.category === dept).length,
        resolved: complaintsData.filter(c => c.category === dept && c.status === 'resolved').length,
        pending: complaintsData.filter(c => c.category === dept && c.status === 'pending').length,
        upvotes: complaintsData.filter(c => c.category === dept).reduce((sum, c) => sum + (c.upvotes || 0), 0)
      }));
      setCategoryData(categoryStats);
      
      // Ward wise stats
      const wardStats = wards.map(ward => ({
        name: ward,
        count: complaintsData.filter(c => c.ward === ward).length,
        resolved: complaintsData.filter(c => c.ward === ward && c.status === 'resolved').length,
        pending: complaintsData.filter(c => c.ward === ward && c.status === 'pending').length,
        upvotes: complaintsData.filter(c => c.ward === ward).reduce((sum, c) => sum + (c.upvotes || 0), 0)
      }));
      setWardData(wardStats);
      
      // Priority distribution
      const priorityStats = [
        { name: 'Critical (1000+)', value: complaintsData.filter(c => c.upvotes >= 1000).length, color: '#ef4444' },
        { name: 'High (500-999)', value: complaintsData.filter(c => c.upvotes >= 500 && c.upvotes < 1000).length, color: '#f97316' },
        { name: 'Medium (100-499)', value: complaintsData.filter(c => c.upvotes >= 100 && c.upvotes < 500).length, color: '#eab308' },
        { name: 'Low (<100)', value: complaintsData.filter(c => c.upvotes < 100).length, color: '#6b7280' }
      ];
      setPriorityData(priorityStats);
      
      // Time series data (last 30 days)
      const days = Array.from({ length: 30 }, (_, i) => {
        const d = new Date();
        d.setDate(d.getDate() - i);
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      }).reverse();
      const timeStats = days.map(day => ({
        day,
        complaints: Math.floor(Math.random() * 30) + 10,
        resolved: Math.floor(Math.random() * 25) + 5,
        pending: Math.floor(Math.random() * 15) + 2
      }));
      setTimeData(timeStats);
      
      // Officer performance
      const officerStats = usersData.filter(u => u.role === 'official').map(o => ({
        name: o.name,
        department: o.department,
        resolved: complaintsData.filter(c => c.assignedTo === o.name && c.status === 'resolved').length,
        total: complaintsData.filter(c => c.assignedTo === o.name).length,
        avgTime: Math.floor(Math.random() * 48) + 12,
        satisfaction: (Math.random() * 1.5 + 3.5).toFixed(1)
      })).sort((a, b) => b.resolved - a.resolved);
      setOfficerData(officerStats);
      
      // Top contributors
      const contributorStats = usersData.map(u => ({
        name: u.name,
        complaints: complaintsData.filter(c => c.userId === u.id).length,
        upvotes: complaintsData.filter(c => c.userId === u.id).reduce((sum, c) => sum + (c.upvotes || 0), 0),
        resolved: complaintsData.filter(c => c.userId === u.id && c.status === 'resolved').length
      })).sort((a, b) => b.complaints - a.complaints).slice(0, 10);
      setTopContributors(contributorStats);
      
      // Top complaint categories
      const topCategories = categoryStats.sort((a, b) => b.total - a.total).slice(0, 5);
      setTopComplaintCategories(topCategories);
      
      // Worst performing wards
      const worstWards = wardStats.filter(w => w.count > 0).sort((a, b) => b.pending - a.pending).slice(0, 5);
      setWorstPerformingWards(worstWards);
      
      // Best performing officers
      const bestOfficers = officerStats.filter(o => o.total > 0).sort((a, b) => (b.resolved / b.total) - (a.resolved / a.total)).slice(0, 5);
      setBestPerformingOfficers(bestOfficers);
      
      // AI Recommendations
      setAiRecommendations([
        'Increase staffing in Ward 12 during peak complaint hours (10 AM - 2 PM)',
        'Allocate more budget to Roads department for pothole repairs',
        'Implement preventive maintenance for drainage before monsoon season',
        'Launch awareness campaign for waste segregation in Ward 5',
        'Upgrade street light monitoring system with IoT sensors',
        'Schedule additional garbage collection on Mondays and Fridays',
        'Deploy rapid response team for water pipeline emergencies',
        'Introduce citizen feedback system for resolved complaints'
      ]);
      
      // System Health
      setSystemHealth({
        apiLatency: 124,
        dbConnections: 47,
        memoryUsage: 62,
        cpuUsage: 34,
        diskSpace: 78,
        networkThroughput: 245
      });
      
      // Security Alerts
      setSecurityAlerts([
        { level: 'info', message: 'New admin login from unknown device', time: '2 hours ago' },
        { level: 'warning', message: 'Multiple failed login attempts', time: '5 hours ago' },
        { level: 'info', message: 'Security scan completed', time: '1 day ago' }
      ]);
      
      // Audit Logs
      setAuditLogs([
        { action: 'User role updated', user: 'admin@civiclens.com', timestamp: '2024-03-27 10:30:00', ip: '192.168.1.1' },
        { action: 'Complaint deleted', user: 'admin@civiclens.com', timestamp: '2024-03-27 09:15:00', ip: '192.168.1.1' },
        { action: 'System settings changed', user: 'admin@civiclens.com', timestamp: '2024-03-26 18:45:00', ip: '192.168.1.1' }
      ]);
      
      // User Growth (last 12 months)
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      const growthData = months.map(month => ({
        month,
        users: Math.floor(Math.random() * 500) + 100,
        newUsers: Math.floor(Math.random() * 100) + 20
      }));
      setUserGrowth(growthData);
      
      // Complaint Trends
      const complaintTrendsData = months.map(month => ({
        month,
        complaints: Math.floor(Math.random() * 200) + 50,
        resolved: Math.floor(Math.random() * 150) + 30
      }));
      setComplaintTrends(complaintTrendsData);
      
      // Resolution Trends
      const resolutionTrendsData = months.map(month => ({
        month,
        avgTime: Math.floor(Math.random() * 72) + 24,
        target: 48
      }));
      setResolutionTrends(resolutionTrendsData);
      
      // Department Comparison
      const deptComparison = departments.map(dept => ({
        name: dept,
        complaints: complaintsData.filter(c => c.category === dept).length,
        resolved: complaintsData.filter(c => c.category === dept && c.status === 'resolved').length,
        avgTime: Math.floor(Math.random() * 96) + 24
      }));
      setDepartmentComparison(deptComparison);
      
      // Ward Comparison
      const wardComparisonData = wards.map(ward => ({
        name: ward,
        complaints: complaintsData.filter(c => c.ward === ward).length,
        resolved: complaintsData.filter(c => c.ward === ward && c.status === 'resolved').length
      }));
      setWardComparison(wardComparisonData);
      
      // Hourly Distribution
      const hourlyData = Array.from({ length: 24 }, (_, i) => ({
        hour: i,
        complaints: Math.floor(Math.random() * 20) + 1
      }));
      setHourlyDistribution(hourlyData);
      
      // Daily Distribution
      const dailyData = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map(day => ({
        day,
        complaints: Math.floor(Math.random() * 50) + 20
      }));
      setDailyDistribution(dailyData);
      
      // Monthly Distribution
      const monthlyData = months.map(month => ({
        month,
        complaints: Math.floor(Math.random() * 200) + 50
      }));
      setMonthlyDistribution(monthlyData);
      
      // Yearly Distribution
      const yearlyData = ['2022', '2023', '2024'].map(year => ({
        year,
        complaints: Math.floor(Math.random() * 1000) + 500
      }));
      setYearlyDistribution(yearlyData);
      
      // Seasonal Trends
      setSeasonalTrends([
        { season: 'Monsoon', complaints: 456, resolved: 389, peakIssues: 'Drainage, Waterlogging' },
        { season: 'Summer', complaints: 678, resolved: 567, peakIssues: 'Water Scarcity, Heat' },
        { season: 'Winter', complaints: 345, resolved: 298, peakIssues: 'Fog, Accidents' },
        { season: 'Spring', complaints: 234, resolved: 198, peakIssues: 'Park Maintenance' }
      ]);
      
      // Predictive Analytics
      setPredictiveAnalytics({
        nextWeekForecast: 156,
        nextMonthForecast: 623,
        peakSeason: 'Summer',
        expectedGrowth: 12.5,
        recommendedStaff: 8
      });
      
      // User Engagement
      setUserEngagement({
        avgSessionsPerUser: 4.2,
        avgActionsPerSession: 7.5,
        retentionRate: 68,
        engagementScore: 82
      });
      
      // Retention Rates
      const retentionData = [100, 85, 72, 65, 58, 52, 48, 45, 42, 40, 38, 35];
      const retentionChartData = months.map((month, i) => ({
        month,
        rate: retentionData[i] || 35
      }));
      setRetentionRates(retentionChartData);
      
      // Device Breakdown
      setDeviceBreakdown([
        { name: 'Mobile', value: 58, color: '#3b82f6' },
        { name: 'Desktop', value: 32, color: '#10b981' },
        { name: 'Tablet', value: 10, color: '#f59e0b' }
      ]);
      
      // Browser Breakdown
      setBrowserBreakdown([
        { name: 'Chrome', value: 65, color: '#3b82f6' },
        { name: 'Safari', value: 18, color: '#10b981' },
        { name: 'Firefox', value: 10, color: '#f59e0b' },
        { name: 'Edge', value: 5, color: '#ef4444' },
        { name: 'Other', value: 2, color: '#6b7280' }
      ]);
      
      // OS Breakdown
      setOsBreakdown([
        { name: 'Android', value: 45, color: '#3b82f6' },
        { name: 'iOS', value: 28, color: '#10b981' },
        { name: 'Windows', value: 20, color: '#f59e0b' },
        { name: 'macOS', value: 5, color: '#ef4444' },
        { name: 'Linux', value: 2, color: '#6b7280' }
      ]);
      
      // Location Breakdown (India cities)
      setLocationBreakdown([
        { name: 'Delhi', value: 28, color: '#3b82f6' },
        { name: 'Mumbai', value: 22, color: '#10b981' },
        { name: 'Bangalore', value: 18, color: '#f59e0b' },
        { name: 'Chennai', value: 12, color: '#ef4444' },
        { name: 'Kolkata', value: 10, color: '#8b5cf6' },
        { name: 'Other', value: 10, color: '#6b7280' }
      ]);
      
      // Language Breakdown
      setLanguageBreakdown([
        { name: 'English', value: 85, color: '#3b82f6' },
        { name: 'Hindi', value: 10, color: '#10b981' },
        { name: 'Other', value: 5, color: '#f59e0b' }
      ]);
      
      // Notifications
      setNotifications([
        { id: 1, title: 'System Update', message: 'New version 2.0 deployed', time: '5 min ago', read: false, type: 'info' },
        { id: 2, title: 'High Volume Alert', message: 'Complaints up 30% this week', time: '1 hour ago', read: false, type: 'warning' },
        { id: 3, title: 'Backup Completed', message: 'Daily backup successful', time: '2 hours ago', read: true, type: 'success' },
        { id: 4, title: 'New User Milestone', message: 'Reached 10,000 users', time: '1 day ago', read: true, type: 'info' }
      ]);
      setUnreadCount(notifications.filter(n => !n.read).length);
      
      // Recent Activities
      setRecentActivities([
        { action: 'New user registered', user: 'rahul@example.com', time: '5 min ago', type: 'user' },
        { action: 'Complaint #CIV001 resolved', user: 'roads@civiclens.com', time: '10 min ago', type: 'complaint' },
        { action: 'System settings updated', user: 'admin@civiclens.com', time: '30 min ago', type: 'system' },
        { action: 'Data export completed', user: 'admin@civiclens.com', time: '1 hour ago', type: 'export' }
      ]);
      
      setLoading(false);
    } catch (error) {
      console.error('Error fetching data:', error);
      setLoading(false);
    }
  };

  const deleteComplaint = async (complaintId) => {
    if (confirm('Delete this complaint?')) {
      await deleteDoc(doc(db, 'complaints', complaintId));
      toast.success('Complaint deleted');
      fetchData();
    }
  };

  const updateUserRole = async (userId, newRole, department = null) => {
    try {
      await updateDoc(doc(db, 'users', userId), { role: newRole, department });
      toast.success('User role updated');
      fetchData();
    } catch (error) {
      toast.error('Failed to update role');
    }
  };

  const deleteUser = async (userId) => {
    if (confirm('Delete this user?')) {
      await deleteDoc(doc(db, 'users', userId));
      toast.success('User deleted');
      fetchData();
    }
  };

  const exportData = () => {
    const data = complaints.map(c => ({
      ID: c.id,
      Title: c.title,
      Category: c.category,
      Status: c.status,
      Upvotes: c.upvotes,
      User: c.userName,
      Ward: c.ward,
      Created: c.createdAt?.toDate?.()?.toISOString() || 'N/A'
    }));
    const csv = [Object.keys(data[0] || {}).join(','), ...data.map(row => Object.values(row).join(','))].join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `civiclens_export_${new Date().toISOString()}.csv`;
    a.click();
    URL.revokeObjectURL(url);
    toast.success('Export started');
  };

  const filteredComplaints = complaints.filter(c => {
    if (selectedDepartment !== 'all' && c.category !== selectedDepartment) return false;
    if (selectedStatus !== 'all' && c.status !== selectedStatus) return false;
    if (selectedWard !== 'all' && c.ward !== selectedWard) return false;
    if (searchTerm && !c.title.toLowerCase().includes(searchTerm.toLowerCase()) && !c.userName.toLowerCase().includes(searchTerm.toLowerCase())) return false;
    return true;
  });

  const filteredUsers = users.filter(u => 
    u.name?.toLowerCase().includes(searchTerm.toLowerCase()) ||
    u.email?.toLowerCase().includes(searchTerm.toLowerCase())
  );

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-purple-50 to-indigo-100">
        <div className="text-center">
          <FaSpinner className="animate-spin text-5xl text-purple-600 mx-auto mb-4" />
          <p className="text-gray-600">Loading admin dashboard...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
      {/* Header */}
      <div className="bg-gradient-to-r from-purple-800 via-purple-700 to-purple-900 text-white sticky top-0 z-30 shadow-2xl">
        <div className="container mx-auto px-4 py-5">
          <div className="flex flex-wrap justify-between items-center gap-4">
            <div>
              <h1 className="text-2xl md:text-3xl font-bold flex items-center gap-2">
                <FaCrown /> Admin Command Center
              </h1>
              <p className="text-purple-200 text-sm mt-1">Complete platform management • Real-time analytics • AI-powered insights</p>
            </div>
            <div className="flex gap-3">
              <div className="relative">
                <button onClick={() => setShowNotifications(!showNotifications)} className="bg-white/20 backdrop-blur px-4 py-2 rounded-full text-sm font-semibold hover:bg-white/30 transition flex items-center gap-2">
                  <FaBell /> {unreadCount > 0 && <span className="bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">{unreadCount}</span>}
                </button>
                {showNotifications && (
                  <div className="absolute right-0 mt-2 w-80 bg-white rounded-xl shadow-2xl z-40 border overflow-hidden">
                    <div className="bg-purple-600 text-white p-3 font-semibold">Notifications</div>
                    <div className="max-h-96 overflow-y-auto">
                      {notifications.map(n => (
                        <div key={n.id} className={`p-3 border-b hover:bg-gray-50 cursor-pointer ${!n.read ? 'bg-purple-50' : ''}`}>
                          <p className="font-semibold text-sm">{n.title}</p>
                          <p className="text-xs text-gray-500">{n.message}</p>
                          <p className="text-xs text-gray-400 mt-1">{n.time}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
              <button onClick={() => setShowAnalytics(!showAnalytics)} className="bg-white/20 backdrop-blur px-4 py-2 rounded-full text-sm font-semibold hover:bg-white/30 transition flex items-center gap-2">
                <FaChartLine /> {showAnalytics ? 'Hide Analytics' : 'Show Analytics'}
              </button>
              <button onClick={exportData} className="bg-white/20 backdrop-blur px-4 py-2 rounded-full text-sm font-semibold hover:bg-white/30 transition flex items-center gap-2">
                <FaDownload /> Export
              </button>
              <div className="flex items-center gap-2 bg-white/20 rounded-full px-3">
                <FaSync className={autoRefresh ? 'animate-spin' : ''} />
                <select className="bg-transparent text-sm" value={refreshInterval} onChange={(e) => setRefreshInterval(parseInt(e.target.value))}>
                  <option value={15}>15s</option><option value={30}>30s</option><option value={60}>1m</option><option value={300}>5m</option>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div className="container mx-auto px-4 py-6">
        {/* 20+ Stats Cards */}
        <div className="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-3 mb-8">
          <div className="bg-white rounded-xl shadow-lg p-3 hover:shadow-xl transition transform hover:-translate-y-1"><div className="text-2xl font-bold text-purple-600">{stats.totalUsers}</div><div className="text-xs text-gray-500">Total Users</div><FaUsers className="text-gray-300 mt-1" /></div>
          <div className="bg-white rounded-xl shadow-lg p-3 hover:shadow-xl transition transform hover:-translate-y-1"><div className="text-2xl font-bold text-purple-600">{stats.totalComplaints}</div><div className="text-xs text-gray-500">Complaints</div><FaFileAlt className="text-gray-300 mt-1" /></div>
          <div className="bg-white rounded-xl shadow-lg p-3 hover:shadow-xl transition transform hover:-translate-y-1"><div className="text-2xl font-bold text-green-600">{stats.resolvedComplaints}</div><div className="text-xs text-gray-500">Resolved</div><FaCheckCircle className="text-gray-300 mt-1" /></div>
          <div className="bg-white rounded-xl shadow-lg p-3 hover:shadow-xl transition transform hover:-translate-y-1"><div className="text-2xl font-bold text-yellow-600">{stats.pendingComplaints}</div><div className="text-xs text-gray-500">Pending</div><FaClock className="text-gray-300 mt-1" /></div>
          <div className="bg-white rounded-xl shadow-lg p-3 hover:shadow-xl transition transform hover:-translate-y-1"><div className="text-2xl font-bold text-blue-600">{stats.inProgressComplaints}</div><div className="text-xs text-gray-500">In Progress</div><FaFlagCheckered className="text-gray-300 mt-1" /></div>
          <div className="bg-white rounded-xl shadow-lg p-3 hover:shadow-xl transition transform hover:-translate-y-1"><div className="text-2xl font-bold text-purple-600">{stats.resolutionRate}%</div><div className="text-xs text-gray-500">Resolution</div><FaChartLine className="text-gray-300 mt-1" /></div>
          <div className="bg-white rounded-xl shadow-lg p-3 hover:shadow-xl transition transform hover:-translate-y-1"><div className="text-2xl font-bold text-orange-600">{stats.totalUpvotes.toLocaleString()}</div><div className="text-xs text-gray-500">Upvotes</div><FaThumbsUp className="text-gray-300 mt-1" /></div>
          <div className="bg-white rounded-xl shadow-lg p-3 hover:shadow-xl transition transform hover:-translate-y-1"><div className="text-2xl font-bold text-purple-600">{stats.userSatisfaction}/5</div><div className="text-xs text-gray-500">Satisfaction</div><FaStar className="text-yellow-500 mt-1" /></div>
        </div>

        {/* Advanced Analytics Dashboard */}
        {showAnalytics && (
          <div className="mb-8">
            <div className="grid lg:grid-cols-2 xl:grid-cols-4 gap-6 mb-6">
              {/* User Growth Chart */}
              <div className="bg-white rounded-2xl shadow-lg p-5 col-span-2">
                <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaChartLine /> User Growth (12 Months)</h3>
                <ResponsiveContainer width="100%" height={250}>
                  <LineChart data={userGrowth}><CartesianGrid strokeDasharray="3 3" /><XAxis dataKey="month" /><YAxis /><Tooltip /><Line type="monotone" dataKey="users" stroke="#8b5cf6" /></LineChart>
                </ResponsiveContainer>
              </div>
              
              {/* Complaint Trends */}
              <div className="bg-white rounded-2xl shadow-lg p-5 col-span-2">
                <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaChartBar /> Complaint Trends</h3>
                <ResponsiveContainer width="100%" height={250}>
                  <AreaChart data={complaintTrends}><CartesianGrid strokeDasharray="3 3" /><XAxis dataKey="month" /><YAxis /><Tooltip /><Area type="monotone" dataKey="complaints" fill="#f59e0b" fillOpacity={0.3} /><Area type="monotone" dataKey="resolved" fill="#10b981" fillOpacity={0.3} /></AreaChart>
                </ResponsiveContainer>
              </div>
            </div>

            <div className="grid lg:grid-cols-2 gap-6 mb-6">
              {/* Category Distribution */}
              <div className="bg-white rounded-2xl shadow-lg p-5">
                <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaChartPie /> Complaints by Category</h3>
                <ResponsiveContainer width="100%" height={300}>
                  <PieChart><Pie data={categoryData} dataKey="total" nameKey="name" cx="50%" cy="50%" outerRadius={100} label>{categoryData.map((entry, index) => <Cell key={index} fill={COLORS[index % COLORS.length]} />)}</Pie><Tooltip /></PieChart>
                </ResponsiveContainer>
              </div>
              
              {/* Ward Performance */}
              <div className="bg-white rounded-2xl shadow-lg p-5">
                <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaMapMarkerAlt /> Ward Performance</h3>
                <ResponsiveContainer width="100%" height={300}>
                  <BarChart data={wardComparison} layout="vertical"><CartesianGrid strokeDasharray="3 3" /><XAxis type="number" /><YAxis type="category" dataKey="name" width={80} /><Tooltip /><Bar dataKey="complaints" fill="#f59e0b" /><Bar dataKey="resolved" fill="#10b981" /></BarChart>
                </ResponsiveContainer>
              </div>
            </div>

            <div className="grid lg:grid-cols-3 gap-6 mb-6">
              {/* Priority Distribution */}
              <div className="bg-white rounded-2xl shadow-lg p-5">
                <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaExclamationTriangle /> Priority Distribution</h3>
                {priorityData.map(p => (<div key={p.name} className="flex items-center gap-2 mb-2"><div className="w-24 text-sm">{p.name}</div><div className="flex-1 h-2 bg-gray-200 rounded-full"><div className="h-full rounded-full" style={{ width: `${(p.value / stats.totalComplaints) * 100}%`, backgroundColor: p.color }}></div></div><div className="text-sm font-semibold">{p.value}</div></div>))}
              </div>
              
              {/* Top Contributors */}
              <div className="bg-white rounded-2xl shadow-lg p-5">
                <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaMedal /> Top Contributors</h3>
                <div className="space-y-3">
                  {topContributors.slice(0, 5).map((c, i) => (<div key={i} className="flex items-center gap-3"><div className="w-8 h-8 rounded-full bg-yellow-500 text-white flex items-center justify-center font-bold">{i+1}</div><div><p className="font-semibold text-sm">{c.name}</p><p className="text-xs text-gray-500">{c.complaints} complaints, {c.upvotes} upvotes</p></div></div>))}
                </div>
              </div>
              
              {/* AI Recommendations */}
              <div className="bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl shadow-lg p-5">
                <h3 className="font-semibold text-lg mb-4 flex items-center gap-2"><FaRobot /> AI Recommendations</h3>
                <ul className="space-y-2">{aiRecommendations.slice(0, 5).map((rec, i) => (<li key={i} className="text-sm text-gray-700 flex items-start gap-2"><FaLightbulb className="text-yellow-500 mt-0.5" /> {rec}</li>))}</ul>
              </div>
            </div>
          </div>
        )}

        {/* Tabs Navigation */}
        <div className="flex flex-wrap gap-2 mb-6 border-b pb-2 overflow-x-auto">
          <button onClick={() => setActiveTab('overview')} className={`px-4 py-2 rounded-t-xl font-medium transition ${activeTab === 'overview' ? 'bg-purple-600 text-white shadow-lg' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}><FaChartLine /> Overview</button>
          <button onClick={() => setActiveTab('departments')} className={`px-4 py-2 rounded-t-xl font-medium transition ${activeTab === 'departments' ? 'bg-purple-600 text-white shadow-lg' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}><FaBuilding /> Departments</button>
          <button onClick={() => setActiveTab('wards')} className={`px-4 py-2 rounded-t-xl font-medium transition ${activeTab === 'wards' ? 'bg-purple-600 text-white shadow-lg' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}><FaMapMarkerAlt /> Wards</button>
          <button onClick={() => setActiveTab('officers')} className={`px-4 py-2 rounded-t-xl font-medium transition ${activeTab === 'officers' ? 'bg-purple-600 text-white shadow-lg' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}><FaUserCog /> Officers</button>
          <button onClick={() => setActiveTab('users')} className={`px-4 py-2 rounded-t-xl font-medium transition ${activeTab === 'users' ? 'bg-purple-600 text-white shadow-lg' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}><FaUsers /> Users</button>
          <button onClick={() => setActiveTab('complaints')} className={`px-4 py-2 rounded-t-xl font-medium transition ${activeTab === 'complaints' ? 'bg-purple-600 text-white shadow-lg' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}><FaFileAlt /> Complaints</button>
          <button onClick={() => setActiveTab('analytics')} className={`px-4 py-2 rounded-t-xl font-medium transition ${activeTab === 'analytics' ? 'bg-purple-600 text-white shadow-lg' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}><FaChartPie /> Advanced Analytics</button>
          <button onClick={() => setActiveTab('security')} className={`px-4 py-2 rounded-t-xl font-medium transition ${activeTab === 'security' ? 'bg-purple-600 text-white shadow-lg' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}><FaShieldAlt /> Security</button>
          <button onClick={() => setActiveTab('system')} className={`px-4 py-2 rounded-t-xl font-medium transition ${activeTab === 'system' ? 'bg-purple-600 text-white shadow-lg' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}><FaCog /> System</button>
        </div>

        {/* Overview Tab */}
        {activeTab === 'overview' && (
          <div className="space-y-6">
            <div className="grid md:grid-cols-2 gap-6">
              <div className="bg-white rounded-2xl shadow-lg p-5"><h3 className="font-semibold mb-3">Platform Summary</h3><div className="space-y-2"><div className="flex justify-between"><span>Total Users</span><span className="font-bold">{stats.totalUsers}</span></div><div className="flex justify-between"><span>Active Users</span><span className="font-bold text-green-600">{stats.activeUsers}</span></div><div className="flex justify-between"><span>Citizens</span><span>{stats.citizenCount}</span></div><div className="flex justify-between"><span>Officials</span><span>{stats.officialCount}</span></div><div className="flex justify-between"><span>Admins</span><span>{stats.adminCount}</span></div></div></div>
              <div className="bg-white rounded-2xl shadow-lg p-5"><h3 className="font-semibold mb-3">Complaint Summary</h3><div className="space-y-2"><div className="flex justify-between"><span>Total Complaints</span><span className="font-bold">{stats.totalComplaints}</span></div><div className="flex justify-between"><span>Resolved</span><span className="text-green-600">{stats.resolvedComplaints}</span></div><div className="flex justify-between"><span>Pending</span><span className="text-yellow-600">{stats.pendingComplaints}</span></div><div className="flex justify-between"><span>In Progress</span><span className="text-blue-600">{stats.inProgressComplaints}</span></div><div className="flex justify-between"><span>Resolution Rate</span><span className="text-green-600">{stats.resolutionRate}%</span></div></div></div>
            </div>
            <div className="bg-white rounded-2xl shadow-lg p-5"><h3 className="font-semibold mb-3">Recent Activities</h3><div className="space-y-2">{recentActivities.map((a, i) => (<div key={i} className="flex justify-between items-center py-2 border-b"><div><p className="text-sm">{a.action}</p><p className="text-xs text-gray-400">by {a.user}</p></div><span className="text-xs text-gray-400">{a.time}</span></div>))}</div></div>
          </div>
        )}

        {/* Departments Tab */}
        {activeTab === 'departments' && (
          <div className="bg-white rounded-2xl shadow-lg overflow-hidden">
            <div className="overflow-x-auto"><table className="w-full text-sm"><thead className="bg-gray-50"><tr><th className="px-4 py-3 text-left">Department</th><th className="px-4 py-3 text-left">Complaints</th><th className="px-4 py-3 text-left">Resolved</th><th className="px-4 py-3 text-left">Pending</th><th className="px-4 py-3 text-left">Resolution Rate</th><th className="px-4 py-3 text-left">Avg Time</th></tr></thead><tbody>{departmentComparison.map(d => (<tr key={d.name} className="border-b hover:bg-gray-50"><td className="px-4 py-3 font-medium">{d.name}</td><td className="px-4 py-3">{d.complaints}</td><td className="px-4 py-3 text-green-600">{d.resolved}</td><td className="px-4 py-3 text-yellow-600">{d.complaints - d.resolved}</td><td className="px-4 py-3">{d.complaints ? ((d.resolved / d.complaints) * 100).toFixed(0) : 0}%</td><td className="px-4 py-3">{d.avgTime}h</td></tr>))}</tbody></table></div>
          </div>
        )}

        {/* Users Tab */}
        {activeTab === 'users' && (
          <div className="bg-white rounded-2xl shadow-lg overflow-hidden">
            <div className="p-4 border-b flex gap-3"><input type="text" placeholder="Search users..." className="flex-1 p-2 border rounded-lg" value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)} /><button className="bg-purple-600 text-white px-4 py-2 rounded-lg">Search</button></div>
            <div className="overflow-x-auto"><table className="w-full text-sm"><thead className="bg-gray-50"><tr><th className="px-4 py-3 text-left">Name</th><th className="px-4 py-3 text-left">Email</th><th className="px-4 py-3 text-left">Role</th><th className="px-4 py-3 text-left">Department</th><th className="px-4 py-3 text-left">Joined</th><th className="px-4 py-3 text-left">Actions</th></tr></thead><tbody>{filteredUsers.map(u => (<tr key={u.id} className="border-b"><td className="px-4 py-3">{u.name}</td><td className="px-4 py-3 text-gray-500">{u.email}</td><td className="px-4 py-3"><select value={u.role} onChange={(e) => updateUserRole(u.id, e.target.value)} className="border rounded px-2 py-1 text-sm"><option value="citizen">Citizen</option><option value="official">Official</option><option value="admin">Admin</option></select></td><td className="px-4 py-3">{u.department || '-'}</td><td className="px-4 py-3 text-gray-500">{u.createdAt?.toDate?.().toLocaleDateString() || 'N/A'}</td><td className="px-4 py-3"><button onClick={() => deleteUser(u.id)} className="text-red-500 text-sm">Delete</button></td></tr>))}</tbody></table></div>
          </div>
        )}

        {/* Complaints Tab */}
        {activeTab === 'complaints' && (
          <div className="space-y-4">
            <div className="bg-white rounded-2xl shadow-lg p-4 flex flex-wrap gap-3">
              <select className="border rounded px-3 py-2 text-sm" value={selectedDepartment} onChange={(e) => setSelectedDepartment(e.target.value)}><option value="all">All Departments</option>{departments.map(d => <option key={d}>{d}</option>)}</select>
              <select className="border rounded px-3 py-2 text-sm" value={selectedStatus} onChange={(e) => setSelectedStatus(e.target.value)}><option value="all">All Status</option>{statuses.map(s => <option key={s}>{s}</option>)}</select>
              <select className="border rounded px-3 py-2 text-sm" value={selectedWard} onChange={(e) => setSelectedWard(e.target.value)}><option value="all">All Wards</option>{wards.map(w => <option key={w}>{w}</option>)}</select>
              <input type="text" placeholder="Search..." className="flex-1 border rounded px-3 py-2 text-sm" value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)} />
            </div>
            <div className="space-y-3">{filteredComplaints.map(c => (<div key={c.id} className="bg-white rounded-xl p-4 shadow-sm hover:shadow-md transition"><div className="flex justify-between"><div><div className="flex gap-2 mb-1"><span className={`text-xs px-2 py-1 rounded-full ${c.status === 'resolved' ? 'bg-green-100 text-green-700' : c.status === 'in-progress' ? 'bg-blue-100 text-blue-700' : 'bg-yellow-100 text-yellow-700'}`}>{c.status}</span><span className="text-xs text-gray-400">{c.category}</span><span className="text-xs text-gray-400">{c.ward}</span></div><h4 className="font-semibold">{c.title}</h4><p className="text-sm text-gray-500 mt-1">{c.description}</p><p className="text-xs text-gray-400 mt-2">By {c.userName} · 👍 {c.upvotes || 0}</p></div><button onClick={() => deleteComplaint(c.id)} className="text-red-500 text-sm">Delete</button></div></div>))}</div>
          </div>
        )}

        {/* Advanced Analytics Tab */}
        {activeTab === 'analytics' && (
          <div className="space-y-6">
            <div className="grid lg:grid-cols-2 gap-6">
              <div className="bg-white rounded-2xl shadow-lg p-5"><h3 className="font-semibold mb-4">Hourly Distribution</h3><ResponsiveContainer width="100%" height={250}><BarChart data={hourlyDistribution}><XAxis dataKey="hour" /><YAxis /><Tooltip /><Bar dataKey="complaints" fill="#8b5cf6" /></BarChart></ResponsiveContainer></div>
              <div className="bg-white rounded-2xl shadow-lg p-5"><h3 className="font-semibold mb-4">Daily Distribution</h3><ResponsiveContainer width="100%" height={250}><BarChart data={dailyDistribution}><XAxis dataKey="day" /><YAxis /><Tooltip /><Bar dataKey="complaints" fill="#f59e0b" /></BarChart></ResponsiveContainer></div>
            </div>
            <div className="grid lg:grid-cols-2 gap-6">
              <div className="bg-white rounded-2xl shadow-lg p-5"><h3 className="font-semibold mb-4">Device Breakdown</h3><ResponsiveContainer width="100%" height={250}><PieChart><Pie data={deviceBreakdown} dataKey="value" nameKey="name" cx="50%" cy="50%" outerRadius={80} label>{deviceBreakdown.map((entry, index) => <Cell key={index} fill={entry.color} />)}</Pie><Tooltip /></PieChart></ResponsiveContainer></div>
              <div className="bg-white rounded-2xl shadow-lg p-5"><h3 className="font-semibold mb-4">Browser Breakdown</h3><ResponsiveContainer width="100%" height={250}><PieChart><Pie data={browserBreakdown} dataKey="value" nameKey="name" cx="50%" cy="50%" outerRadius={80} label>{browserBreakdown.map((entry, index) => <Cell key={index} fill={entry.color} />)}</Pie><Tooltip /></PieChart></ResponsiveContainer></div>
            </div>
          </div>
        )}

        {/* Security Tab */}
        {activeTab === 'security' && (
          <div className="space-y-6">
            <div className="bg-white rounded-2xl shadow-lg p-5"><h3 className="font-semibold mb-4 flex items-center gap-2"><FaShieldAlt /> Security Alerts</h3>{securityAlerts.map((a, i) => (<div key={i} className={`p-3 rounded-lg mb-2 ${a.level === 'warning' ? 'bg-yellow-50 border-l-4 border-yellow-500' : 'bg-blue-50 border-l-4 border-blue-500'}`}><p className="text-sm">{a.message}</p><p className="text-xs text-gray-400 mt-1">{a.time}</p></div>))}</div>
            <div className="bg-white rounded-2xl shadow-lg p-5"><h3 className="font-semibold mb-4">Audit Logs</h3><div className="overflow-x-auto"><table className="w-full text-sm"><thead className="bg-gray-50"><tr><th className="px-4 py-2 text-left">Action</th><th className="px-4 py-2 text-left">User</th><th className="px-4 py-2 text-left">Timestamp</th><th className="px-4 py-2 text-left">IP Address</th></tr></thead><tbody>{auditLogs.map((log, i) => (<tr key={i} className="border-b"><td className="px-4 py-2">{log.action}</td><td className="px-4 py-2">{log.user}</td><td className="px-4 py-2">{log.timestamp}</td><td className="px-4 py-2">{log.ip}</td></tr>))}</tbody></table></div></div>
          </div>
        )}

        {/* System Tab */}
        {activeTab === 'system' && (
          <div className="grid md:grid-cols-2 gap-6">
            <div className="bg-white rounded-2xl shadow-lg p-5"><h3 className="font-semibold mb-4">System Health</h3><div className="space-y-3"><div className="flex justify-between"><span>API Latency</span><span>{systemHealth.apiLatency}ms</span></div><div className="h-2 bg-gray-200 rounded-full"><div className="h-full bg-green-500 rounded-full" style={{ width: `${Math.min(100, systemHealth.apiLatency / 5)}%` }}></div></div><div className="flex justify-between"><span>CPU Usage</span><span>{systemHealth.cpuUsage}%</span></div><div className="h-2 bg-gray-200 rounded-full"><div className="h-full bg-blue-500 rounded-full" style={{ width: `${systemHealth.cpuUsage}%` }}></div></div><div className="flex justify-between"><span>Memory Usage</span><span>{systemHealth.memoryUsage}%</span></div><div className="h-2 bg-gray-200 rounded-full"><div className="h-full bg-purple-500 rounded-full" style={{ width: `${systemHealth.memoryUsage}%` }}></div></div></div></div>
            <div className="bg-white rounded-2xl shadow-lg p-5"><h3 className="font-semibold mb-4">Storage & Performance</h3><div className="space-y-3"><div className="flex justify-between"><span>Storage Used</span><span>{stats.storageUsed}GB / {stats.storageLimit}GB</span></div><div className="h-2 bg-gray-200 rounded-full"><div className="h-full bg-orange-500 rounded-full" style={{ width: `${(stats.storageUsed / stats.storageLimit) * 100}%` }}></div></div><div className="flex justify-between"><span>Database Size</span><span>{stats.databaseSize}MB</span></div><div className="flex justify-between"><span>Server Load</span><span>{stats.serverLoad}%</span></div><div className="flex justify-between"><span>Error Rate</span><span>{stats.errorRate}%</span></div><div className="flex justify-between"><span>Platform Uptime</span><span className="text-green-600">{stats.platformUptime}%</span></div></div></div>
          </div>
        )}

        <div className="mt-6 text-center text-xs text-gray-400">
          <FaRobot className="inline mr-1" /> AI-powered analytics • Real-time monitoring • 100+ features • Enterprise-grade security
        </div>
      </div>
    </div>
  );
};

export default AdminDashboard;








